# Database
DATABASE_URL=postgresql://username:password@localhost/soccer_betting
TEST_DATABASE_URL=postgresql://username:password@localhost/soccer_betting_test

# JWT
SECRET_KEY=your-super-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Soccer Betting App

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# App Configuration
APP_NAME=Soccer Betting API
APP_VERSION=1.0.0
DEBUG=True
