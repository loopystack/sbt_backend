# Database Configuration
# Choose one of the following database configurations:

# Option 1: SQLite (for development)
DATABASE_URL=sqlite:///./sportsbetting.db

# Option 2: PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/sportsbetting_db

# Option 3: MySQL
# DATABASE_URL=mysql://username:password@localhost:3306/sportsbetting_db

# JWT Configuration
SECRET_KEY=your-secret-key-here-make-it-very-long-and-random-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Soccer Betting App

# Frontend URL
FRONTEND_URL=http://localhost:3000

# App Configuration
APP_NAME=Soccer Betting API
APP_VERSION=1.0.0
DEBUG=true

# Payment Configuration
PAYMENT_MODE=test

# Blockchain Verification
BLOCKCHAIN_TEST_MODE=false

# Stripe API Keys (add your keys here)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=

# PayPal Configuration (add your keys here)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox