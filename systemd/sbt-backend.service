[Unit]
Description=Sportsbet FastAPI Backend API
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sbt_backend
EnvironmentFile=/etc/sportsbet/env
ExecStart=/home/deploy/sbt_backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5001 --workers 4
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sbt-backend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/sportsbet
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
LimitNOFILE=1024
LimitNPROC=512

[Install]
WantedBy=multi-user.target