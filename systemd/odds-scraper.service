[Unit]
Description=OddsPortal odds scraper (daily job)
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sbt_backend
EnvironmentFile=/home/deploy/sbt_backend/.env
ExecStart=/home/deploy/sbt_backend/venv/bin/python /home/deploy/sbt_backend/dataanalytics/get_real_odds_oddsportal.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sbt-odds-scraper

# Chrome/Chromium may need less restrictive sandboxing; relax if headless Chrome fails
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
CapabilityBoundingSet=~CAP_SYS_ADMIN
LimitNOFILE=512
LimitNPROC=256
