[Unit]
Description=Daily bet settlement (settle bets for matches with results in odds table)
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sbt_backend
EnvironmentFile=/home/deploy/sbt_backend/.env
ExecStart=/home/deploy/sbt_backend/venv/bin/python /home/deploy/sbt_backend/scripts/run_daily_bet_settlement.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sbt-bet-settlement

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
LimitNOFILE=512
LimitNPROC=256
