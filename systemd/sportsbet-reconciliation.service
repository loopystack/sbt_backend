[Unit]
Description=Sportsbet Daily Reconciliation Job
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sbt_backend
EnvironmentFile=/home/deploy/sbt_backend/.env
ExecStart=/home/deploy/sbt_backend/venv/bin/python scripts/run_daily_reconciliation.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sbt-reconciliation

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
CapabilityBoundingSet=~CAP_SYS_ADMIN
LimitNOFILE=512
LimitNPROC=256