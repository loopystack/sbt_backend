[Unit]
Description=Sportsbet Deposit Monitor Worker
After=network.target postgresql.service sbt-backend.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sbt_backend
EnvironmentFile=/home/deploy/sbt_backend/.env
ExecStart=/home/deploy/sbt_backend/venv/bin/python run_deposit_monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sbt-deposit-monitor

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/sportsbet
CapabilityBoundingSet=~CAP_SYS_ADMIN
LimitNOFILE=512
LimitNPROC=256

[Install]
WantedBy=multi-user.target